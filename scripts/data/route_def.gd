class_name RouteDef
extends Resource
## A minibus route: its centreline, named stops and rules.
## Kitwe routes are generated by tools/osm_import.py from OpenStreetMap.

@export var route_name := "Route"
@export_multiline var description := ""
## Closed loop of centreline points, in driving order.
@export var path_points := PackedVector3Array()
@export var road_width := 12.0
@export var stop_names := PackedStringArray()
## Distance in metres along the loop for each stop (same order as stop_names).
@export var stop_offsets := PackedFloat32Array()
@export var fare_kwacha := 10
@export var time_limit_sec := 240.0
## Optional OSM map (JSON from tools/osm_import.py). Empty = graybox world.
@export_file("*.json") var map_data := ""

@export_group("Facilities")
## Metres along the loop of each filling station.
@export var fuel_offsets := PackedFloat32Array()
## Metres along the loop of each police checkpoint.
@export var checkpoint_offsets := PackedFloat32Array()
@export var speed_limit_kmh := 60
